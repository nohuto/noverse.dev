---
import config from 'virtual:starlight/user-config';

import LanguageSelect from 'virtual:starlight/components/LanguageSelect';
import Search from 'virtual:starlight/components/Search';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';
import { getActiveRepo } from '../../utils/active-repo';
import { getZenTarget } from '../../utils/zen-mode';
import HeaderIcon from './HeaderIcon.astro';
import KeyboardShortcuts from './KeyboardShortcuts.astro';

const { id, sidebar } = Astro.locals.starlightRoute;

const activeRepo = getActiveRepo(id, sidebar);
const hasActiveRepo = Boolean(activeRepo && !['index', '404'].includes(activeRepo));
const repoHref = hasActiveRepo ? `https://github.com/nohuto/${activeRepo}` : '';

const { target: zenTarget, isCurrent: inZenMode } = getZenTarget(Astro.locals.starlightViewModes.modes);

const shouldRenderSearch =
  config.pagefind || config.components.Search !== '@astrojs/starlight/components/Search.astro';
---

<div class="header">
  <div class="title-wrapper sl-flex">
    <a class="prompt-line" href="/docs/" aria-label="Go to the docs home page">
      <span class="prompt-user">nohuto</span>
      <span class="prompt-sep">@</span>
      <span class="prompt-host">noverse</span>
    </a>
  </div>
  <div class="sl-flex print:hidden">
    {shouldRenderSearch && <Search />}
  </div>
  <div class="sl-hidden md:sl-flex print:hidden right-group">
    <KeyboardShortcuts zenHref={zenTarget?.href} />
    {
      zenTarget && (
        <a
          class="header-icon-link zen-link"
          href={zenTarget.href}
          aria-label={Astro.locals.t(zenTarget.switchToText)}
          aria-keyshortcuts="Control+Shift+X"
          data-nv-tip="Ctrl+Shift+X"
          data-zen-toggle
        >
          <HeaderIcon name={inZenMode ? 'zen-exit' : 'zen'} />
        </a>
      )
    }
    {
      hasActiveRepo && (
        <a class="header-icon-link repo-link" href={repoHref} target="_blank" rel="noopener noreferrer" aria-label={`Open ${activeRepo} repository`}>
          <HeaderIcon name="repo" />
        </a>
      )
    }
    <a class="header-icon-link external-link" href="https://github.com/nohuto" rel="me" aria-label="GitHub">
      <HeaderIcon name="github" />
    </a>
    <a class="header-icon-link external-link" href="https://discord.noverse.dev" rel="me" aria-label="Discord">
      <HeaderIcon name="discord" />
    </a>
    <a class="header-icon-link home-link" href="/" aria-label="Go to homepage">
      <HeaderIcon name="home" />
    </a>
    <span class="header-divider" aria-hidden="true"></span>
    <ThemeSelect />
    <LanguageSelect />
  </div>
</div>

<style>
  @layer starlight.core {
    :global(:root) {
      --sl-nav-height: 2.875rem;
      --sl-nav-pad-y: 0.375rem;
    }

    @media (min-width: 50rem) {
      :global(:root) {
        --sl-nav-height: 2.875rem;
        --sl-nav-pad-x: 1.25rem;
      }
    }

    .header {
      display: flex;
      gap: var(--sl-nav-gap);
      justify-content: space-between;
      align-items: center;
      height: 100%;
    }

    .title-wrapper {
      overflow: clip;
      padding: 0.125rem;
      margin: -0.125rem;
      min-width: 0;
    }

    .right-group {
      --nv-header-control-gap: 0.75rem;
      align-items: center;
      gap: var(--nv-header-control-gap);
      padding-inline-end: 0.5rem;
    }

    .right-group > :global(telescope-search) {
      display: inline-flex;
    }

    .prompt-line {
      display: inline-flex;
      align-items: center;
      flex-wrap: nowrap;
      gap: 0.15rem;
      min-width: 0;
      color: var(--sl-color-text);
      font-size: 0.75rem;
      line-height: 1;
      letter-spacing: 0.02em;
      text-decoration: none;
      text-transform: lowercase;
      white-space: nowrap;
    }

    .prompt-user,
    .prompt-host {
      color: var(--sl-color-accent);
    }

    .prompt-sep {
      color: var(--sl-color-text);
    }

    .prompt-line:hover .prompt-user,
    .prompt-line:hover .prompt-host,
    .prompt-line:focus-visible .prompt-user,
    .prompt-line:focus-visible .prompt-host {
      color: var(--sl-color-accent-high);
    }

    .prompt-line:focus-visible {
      outline: none;
    }

    .header-icon-link {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: var(--nv-header-icon-size);
      height: var(--nv-header-control-height);
      color: var(--sl-color-gray-2);
      line-height: 0;
      text-decoration: none;
    }

    .header-icon-link:is(:hover, :focus-visible) {
      color: var(--sl-color-accent-high);
      outline: none;
    }

    .header-divider {
      flex: none;
      width: 1px;
      height: var(--nv-header-control-height);
      background-color: var(--sl-color-gray-5);
    }
    @media (min-width: 50rem) {
      :global(:root[data-has-sidebar]) {
        --__sidebar-pad: calc(2 * var(--sl-nav-pad-x));
      }

      :global(:root:not([data-has-toc])) {
        --__toc-width: 0rem;
      }

      .header {
        --__sidebar-width: max(0rem, var(--sl-content-inline-start, 0rem) - var(--sl-nav-pad-x));
        --__main-column-fr: calc(
          (
              100% + var(--__sidebar-pad, 0rem) - var(--__toc-width, var(--sl-sidebar-width)) -
                (2 * var(--__toc-width, var(--sl-nav-pad-x))) - var(--sl-content-inline-start, 0rem) -
                var(--sl-content-width)
            ) / 2
        );
        display: grid;
        grid-template-columns:
          minmax(calc(var(--__sidebar-width) + max(0rem, var(--__main-column-fr) - var(--sl-nav-gap))), auto)
          1fr
          auto;
        align-content: center;
      }
    }
  }
</style>
