---
import LanguageSelect from 'virtual:starlight/components/LanguageSelect';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';
import { getActiveRepo } from '../../utils/active-repo';
import { getZenTarget } from '../../utils/zen-mode';
import HeaderIcon from './HeaderIcon.astro';

const { id, sidebar } = Astro.locals.starlightRoute;

const activeRepo = getActiveRepo(id, sidebar);
const hasActiveRepo = Boolean(activeRepo && !['index', '404'].includes(activeRepo));
const repoHref = hasActiveRepo ? `https://github.com/nohuto/${activeRepo}` : '';

const { target: zenTarget, isCurrent: inZenMode } = getZenTarget(Astro.locals.starlightViewModes.modes);
---

<div class="mobile-preferences sl-flex">
  <div class="mobile-links">
    <button type="button" class="mobile-icon-link" aria-label="Open Telescope Search" data-mobile-telescope>
      <HeaderIcon name="telescope" />
    </button>
    {
      zenTarget && (
        <a class="mobile-icon-link" href={zenTarget.href} aria-label={Astro.locals.t(zenTarget.switchToText)}>
          <HeaderIcon name={inZenMode ? 'zen-exit' : 'zen'} />
        </a>
      )
    }
    {
      hasActiveRepo && (
        <a class="mobile-icon-link" href={repoHref} target="_blank" rel="noopener noreferrer" aria-label={`Open ${activeRepo} repository`}>
          <HeaderIcon name="repo" />
        </a>
      )
    }
    <a class="mobile-icon-link" href="https://github.com/nohuto" rel="me" aria-label="GitHub">
      <HeaderIcon name="github" />
    </a>
    <a class="mobile-icon-link" href="https://discord.noverse.dev" rel="me" aria-label="Discord">
      <HeaderIcon name="discord" />
    </a>
    <a class="mobile-icon-link" href="/" aria-label="Go to homepage">
      <HeaderIcon name="home" />
    </a>
  </div>
  <ThemeSelect />
  <LanguageSelect />
</div>

<script>
  document.addEventListener('click', (event) => {
    const trigger = (event.target as Element | null)?.closest('[data-mobile-telescope]');
    if (!trigger) return;
    document.querySelector<HTMLButtonElement>('telescope-search button')?.click();
  });
</script>

<style>
  .mobile-preferences {
    position: relative;
    justify-content: space-between;
    flex-wrap: wrap;
    align-items: center;
    border-top: 1px solid var(--sl-color-gray-6);
    column-gap: 0.75rem;
    row-gap: 0.625rem;
    padding: 0.5rem 0;
  }

  .mobile-links {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-width: 0;
    margin-inline-end: auto;
  }

  .mobile-icon-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.75rem;
    min-height: 1.75rem;
    padding: 0.25rem;
    margin: 0;
    border: 0;
    background: transparent;
    color: var(--sl-color-gray-2);
    text-decoration: none;
  }

  .mobile-icon-link:is(:hover, :focus-visible, :active) {
    color: var(--sl-color-accent-high);
    outline: none;
  }
</style>
