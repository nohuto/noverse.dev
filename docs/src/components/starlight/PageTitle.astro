---
import Default from '@astrojs/starlight/components/PageTitle.astro';
import { getZenTarget } from '../../utils/zen-mode';
import HeaderIcon from './HeaderIcon.astro';

const { entry } = Astro.locals.starlightRoute;
const isTemplateSplash = entry.data.template === 'splash';

const { target: zenTarget, isCurrent: inZenMode } = getZenTarget(Astro.locals.starlightViewModes.modes);
---

{
  isTemplateSplash ? (
    <Default />
  ) : (
    <div class="docs-page-title-row">
      <Default />
      {zenTarget && (
        <div class="docs-page-title-switcher">
          <a
            class="docs-page-title-zen"
            href={zenTarget.href}
            aria-label={Astro.locals.t(zenTarget.switchToText)}
            aria-keyshortcuts="Control+Shift+X"
            data-nv-tip="Ctrl+Shift+X"
          >
            <HeaderIcon name={inZenMode ? 'zen-exit' : 'zen'} />
          </a>
        </div>
      )}
    </div>
  )
}

<style>
  .docs-page-title-row {
    display: block;
  }

  .docs-page-title-switcher {
    display: none;
    align-items: center;
    justify-content: flex-end;
    margin-top: 0.35rem;
  }

  .docs-page-title-zen {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--sl-color-gray-2);
    line-height: 0;
    text-decoration: none;
  }

  .docs-page-title-zen:is(:hover, :focus-visible) {
    color: var(--sl-color-accent-high);
    outline: none;
  }

  body:has(.starlight-view-modes-zen-mode-no-header):has(.starlight-view-modes-zen-mode-no-table-of-contents) .docs-page-title-row {
    display: grid;
    grid-template-columns: 1fr 2rem;
    align-items: center;
  }

  body:has(.starlight-view-modes-zen-mode-no-header):has(.starlight-view-modes-zen-mode-no-table-of-contents) .docs-page-title-switcher {
    display: flex !important;
    margin-top: 0;
  }

  @media (max-width: 50rem) {
    body:has(.starlight-view-modes-zen-mode-no-header) .docs-page-title-row {
      display: grid;
      grid-template-columns: 1fr 2rem;
      align-items: center;
    }

    body:has(.starlight-view-modes-zen-mode-no-header) .docs-page-title-switcher {
      display: flex !important;
      margin-top: 0;
    }
  }
</style>
