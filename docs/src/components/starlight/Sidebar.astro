---
import SidebarPersister from '@astrojs/starlight/components/SidebarPersister.astro';
import SidebarSublist from '@astrojs/starlight/components/SidebarSublist.astro';
import type { StarlightRouteData } from '@astrojs/starlight/route-data';
import MobileMenuFooter from './MobileMenuFooter.astro';

type SidebarEntry = StarlightRouteData['sidebar'][number];

const { sidebar } = Astro.locals.starlightRoute;
const renderedSidebar = flattenSectionsGroups(sidebar);

function slugifyLabel(value: string): string {
  return String(value || '')
    .trim()
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '');
}

function cloneGroup(
  group: Extract<SidebarEntry, { type: 'group' }>,
  entries: SidebarEntry[],
): SidebarEntry {
  return { ...group, entries };
}

function flattenSectionsGroups(
  entries: SidebarEntry[],
  capitalizeGroups = false,
): SidebarEntry[] {
  const flattened: SidebarEntry[] = [];
  const orderedEntries = orderSectionsFirst(entries);

  for (const entry of orderedEntries) {
    if (!entry) continue;

    if (entry.type === 'link') {
      flattened.push(entry);
      continue;
    }

    if (entry.type === 'group') {
      const isSectionsGroup = slugifyLabel(entry.label) === 'sections';
      const capitalizeChildren =
        capitalizeGroups || slugifyLabel(entry.label) === 'windbg-notes';
      const flattenedChildren = flattenSectionsGroups(
        entry.entries || [],
        capitalizeChildren,
      );
      if (isSectionsGroup) {
        flattened.push(...flattenedChildren);
        continue;
      }
      const label = capitalizeGroups
        ? entry.label.charAt(0).toUpperCase() + entry.label.slice(1)
        : entry.label;
      flattened.push(cloneGroup({ ...entry, label }, flattenedChildren));
    }
  }

  return flattened;
}

function orderSectionsFirst(entries: SidebarEntry[]): SidebarEntry[] {
  const sections: SidebarEntry[] = [];
  const others: SidebarEntry[] = [];

  for (const entry of entries || []) {
    if (isSectionsGroup(entry)) {
      sections.push(entry);
      continue;
    }
    others.push(entry);
  }

  return [...sections, ...others];
}

function isSectionsGroup(entry: SidebarEntry): boolean {
  return Boolean(
    entry && entry.type === 'group' && slugifyLabel(entry.label) === 'sections',
  );
}
---

<div class="sidebar-tree-search">
  <label class="sidebar-tree-search-wrap" for="sidebar-tree-search">
    <span class="sidebar-tree-search-icon" aria-hidden="true"></span>
    <input
      type="text"
      id="sidebar-tree-search"
      class="sidebar-tree-search-input"
      aria-label="Filter sidebar"
      autocomplete="off"
      spellcheck="false"
    />
    <kbd class="sidebar-tree-shortcut" aria-hidden="true">
      <kbd data-sidebar-primary-key>Ctrl</kbd>
      <kbd>Shift</kbd>
      <kbd>F</kbd>
    </kbd>
  </label>
  <p id="sidebar-tree-no-results" class="sidebar-tree-no-results sl-hidden">
    No matching section(s)
  </p>
</div>

<SidebarPersister>
  <SidebarSublist sublist={renderedSidebar} />
</SidebarPersister>

<p class="sidebar-docs-copyright">
  <span class="copyright-icon" aria-hidden="true"></span>2026 nohuto
</p>

<div class="md:sl-hidden">
  <MobileMenuFooter />
</div>

<script>
  const searchInput = document.getElementById('sidebar-tree-search');
  const noResultsMessage = document.getElementById('sidebar-tree-no-results');
  const sidebarTree = document.querySelector('sl-sidebar-state-persist');

  if (
    searchInput instanceof HTMLInputElement &&
    noResultsMessage &&
    sidebarTree
  ) {
    const primaryKey = document.querySelector('[data-sidebar-primary-key]');
    if (primaryKey && /(Mac|iPhone|iPod|iPad)/i.test(navigator.platform)) {
      primaryKey.textContent = '⌘';
    }

    const detailsElements = Array.from(sidebarTree.querySelectorAll('details'));
    const items = Array.from(sidebarTree.querySelectorAll('li'));
    let openStatesBeforeFilter: Map<HTMLDetailsElement, boolean> | null = null;

    const matchesAllTerms = (text: string, searchTerms: string[]) => {
      const lowerText = text.toLowerCase();
      return searchTerms.every((term) => lowerText.includes(term));
    };

    const showParentChain = (element: Element) => {
      let parent = element.parentElement;
      while (parent && parent !== sidebarTree) {
        if (parent instanceof HTMLLIElement) parent.style.display = '';
        if (parent instanceof HTMLDetailsElement) parent.open = true;
        parent = parent.parentElement;
      }
    };

    const showDirectChildren = (details: HTMLDetailsElement) => {
      details.open = true;
      details
        .querySelectorAll<HTMLLIElement>(':scope > ul > li')
        .forEach((child) => {
          child.style.display = '';
        });
    };

    const filterSidebarItems = (query: string) => {
      if (!query.trim()) {
        items.forEach((item) => {
          item.style.display = '';
        });
        openStatesBeforeFilter?.forEach((open, details) => {
          details.open = open;
        });
        openStatesBeforeFilter = null;
        noResultsMessage.classList.add('sl-hidden');
        return;
      }

      openStatesBeforeFilter ??= new Map(
        detailsElements.map((details) => [details, details.open]),
      );

      const searchTerms = query.toLowerCase().split(/\s+/).filter(Boolean);
      items.forEach((item) => {
        item.style.display = 'none';
      });
      detailsElements.forEach((details) => {
        details.open = false;
      });

      const matchedItems = new Set<HTMLLIElement>();

      detailsElements.forEach((details) => {
        const summary = details.querySelector(':scope > summary');
        if (!matchesAllTerms(summary?.textContent || '', searchTerms)) return;
        const parentLi = details.closest('li');
        if (!parentLi || matchedItems.has(parentLi)) return;
        parentLi.style.display = '';
        showDirectChildren(details);
        showParentChain(parentLi);
        matchedItems.add(parentLi);
      });

      items.forEach((item) => {
        if (matchedItems.has(item) || item.querySelector(':scope > details'))
          return;
        const link = item.querySelector(':scope > a');
        if (!link || !matchesAllTerms(link.textContent || '', searchTerms))
          return;
        item.style.display = '';
        showParentChain(item);
        matchedItems.add(item);
      });

      if (matchedItems.size === 0) {
        items.forEach((item) => {
          const textContent = (item.textContent || '').toLowerCase();
          if (!searchTerms.some((term) => textContent.includes(term))) return;
          item.style.display = '';
          const details =
            item.querySelector<HTMLDetailsElement>(':scope > details');
          if (details) showDirectChildren(details);
          showParentChain(item);
          matchedItems.add(item);
        });
      }

      noResultsMessage.classList.toggle('sl-hidden', matchedItems.size > 0);
    };

    searchInput.addEventListener('input', () => {
      filterSidebarItems(searchInput.value);
    });

    searchInput.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      searchInput.value = '';
      filterSidebarItems('');
    });
  }
</script>
