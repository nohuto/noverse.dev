---
import {
  DEFAULT_DARK_THEME,
  DEFAULT_LIGHT_THEME,
  THEME_KEY,
  THEME_SYSTEM,
  lightThemes,
  themes,
} from '../../../../src/data/themes';
---

<script
  is:inline
  define:vars={{
    themeKey: THEME_KEY,
    themeOptions: themes.map(([value]) => value),
    lightOptions: [...lightThemes],
    systemTheme: THEME_SYSTEM,
    darkTheme: DEFAULT_DARK_THEME,
    lightTheme: DEFAULT_LIGHT_THEME,
  }}
>
  let setting = '';
  try {
    setting = (localStorage.getItem(themeKey) || '').trim();
  } catch {}
  if (!themeOptions.includes(setting)) setting = systemTheme;
  const theme =
    setting !== systemTheme
      ? setting
      : matchMedia('(prefers-color-scheme: light)').matches
        ? lightTheme
        : darkTheme;
  const root = document.documentElement;
  root.dataset.docsThemeSetting = setting;
  root.dataset.docsTheme = theme;
  root.dataset.theme = lightOptions.includes(theme) ? 'light' : 'dark';
</script>
