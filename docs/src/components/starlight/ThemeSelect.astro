---
import { themes } from '../../../../src/data/themes';
---

<docs-theme-select>
  <button
    type="button"
    class="docs-theme-trigger"
    data-theme-trigger
    aria-haspopup="menu"
    aria-expanded="false"
    aria-label="Select docs theme"
  >
    <span class="docs-theme-current" data-current-label>
      System
    </span>
  </button>

  <div class="docs-theme-popover" data-theme-popover hidden>
    <div class="docs-theme-panel">
      <ul class="docs-theme-list" role="menu" aria-label="Select docs theme">
        {themes.map(([id, label]) => (
          <li>
            <button
              type="button"
              class="docs-theme-option"
              role="menuitemradio"
              tabindex="-1"
              aria-selected="false"
              aria-checked="false"
              data-active="false"
              data-theme-option={id}
              data-theme-label={label}
            >
              <span>{label}</span>
            </button>
          </li>
        ))}
      </ul>
    </div>
  </div>
</docs-theme-select>

<script is:inline>
  (() => {
    const picker = document.currentScript.previousElementSibling;
    const option = picker.querySelector(
      `[data-theme-option="${document.documentElement.dataset.docsThemeSetting}"]`,
    );
    const label = picker.querySelector('[data-current-label]');
    if (option && label) label.textContent = option.dataset.themeLabel;
  })();
</script>

<script>
  import {
    DEFAULT_DARK_THEME,
    DEFAULT_LIGHT_THEME,
    THEME_KEY,
    THEME_SYSTEM,
    lightThemes,
  } from '../../../../src/data/themes';

  const root = document.documentElement;
  const lightQuery = matchMedia('(prefers-color-scheme: light)');
  const currentSetting = () => root.dataset.docsThemeSetting || THEME_SYSTEM;

  const applyTheme = (setting: string) => {
    const theme =
      setting !== THEME_SYSTEM
        ? setting
        : lightQuery.matches
          ? DEFAULT_LIGHT_THEME
          : DEFAULT_DARK_THEME;
    root.dataset.docsThemeSetting = setting;
    root.dataset.docsTheme = theme;
    root.dataset.theme = lightThemes.has(theme) ? 'light' : 'dark';
  };

  const updatePickers = () => {
    const setting = currentSetting();
    document.querySelectorAll('docs-theme-select').forEach((picker) => {
      let activeLabel = '';
      picker
        .querySelectorAll<HTMLButtonElement>('[data-theme-option]')
        .forEach((option) => {
          const isActive = option.dataset.themeOption === setting;
          option.setAttribute('aria-selected', String(isActive));
          option.setAttribute('aria-checked', String(isActive));
          option.tabIndex = isActive ? 0 : -1;
          option.dataset.active = String(isActive);
          if (isActive) activeLabel = option.dataset.themeLabel || '';
        });
      const label = activeLabel || setting;
      const current = picker.querySelector('[data-current-label]');
      if (current) current.textContent = label;
      picker
        .querySelector('[data-theme-trigger]')
        ?.setAttribute(
          'aria-label',
          `Select docs theme. Current theme: ${label}`,
        );
    });
  };

  const setTheme = (setting: string) => {
    applyTheme(setting);
    try {
      localStorage.setItem(THEME_KEY, setting);
    } catch {}
    updatePickers();
  };

  lightQuery.addEventListener('change', () => {
    if (currentSetting() === THEME_SYSTEM) applyTheme(THEME_SYSTEM);
  });

  class DocsThemeSelect extends HTMLElement {
    handleDocumentPointerDown = (event: PointerEvent) => {
      if (!(event.target instanceof Node) || this.contains(event.target))
        return;
      this.closeMenu();
    };

    handleDocumentKeyDown = (event: KeyboardEvent) => {
      if (event.key !== 'Escape') return;
      this.closeMenu();
      this.trigger?.focus();
    };

    handleTriggerClick = () => {
      this.toggleMenu();
    };

    handleTriggerKeyDown = (event: KeyboardEvent) => {
      if (!['ArrowDown', 'ArrowUp', 'Enter', ' '].includes(event.key)) return;
      event.preventDefault();
      this.openMenu(event.key === 'ArrowUp' ? 'last' : 'active');
    };

    handleOptionClick = (event: Event) => {
      if (!(event.currentTarget instanceof HTMLButtonElement)) return;
      const theme = event.currentTarget.dataset.themeOption;
      if (!theme) return;
      setTheme(theme);
      this.closeMenu();
      this.trigger?.focus();
    };

    handleOptionKeyDown = (event: KeyboardEvent) => {
      if (!(event.currentTarget instanceof HTMLButtonElement)) return;
      const optionIndex = this.options.indexOf(event.currentTarget);
      if (optionIndex === -1) return;

      if (event.key === 'ArrowDown') {
        event.preventDefault();
        this.options[(optionIndex + 1) % this.options.length]?.focus();
        return;
      }

      if (event.key === 'ArrowUp') {
        event.preventDefault();
        this.options[
          (optionIndex - 1 + this.options.length) % this.options.length
        ]?.focus();
        return;
      }

      if (event.key === 'Home') {
        event.preventDefault();
        this.options[0]?.focus();
        return;
      }

      if (event.key === 'End') {
        event.preventDefault();
        this.options[this.options.length - 1]?.focus();
        return;
      }

      if (event.key === 'Tab') {
        this.closeMenu();
      }
    };

    trigger?: HTMLButtonElement | null;
    menu?: HTMLElement | null;
    options: HTMLButtonElement[] = [];

    connectedCallback() {
      this.trigger = this.querySelector('[data-theme-trigger]');
      this.menu = this.querySelector('[data-theme-popover]');
      this.options = Array.from(this.querySelectorAll('[data-theme-option]'));
      this.dataset.open = this.dataset.open || 'false';

      this.trigger?.addEventListener('click', this.handleTriggerClick);
      this.trigger?.addEventListener('keydown', this.handleTriggerKeyDown);
      this.options.forEach((option) =>
        option.addEventListener('click', this.handleOptionClick),
      );
      this.options.forEach((option) =>
        option.addEventListener('keydown', this.handleOptionKeyDown),
      );
      document.addEventListener('pointerdown', this.handleDocumentPointerDown);
      document.addEventListener('keydown', this.handleDocumentKeyDown);
      updatePickers();
    }

    disconnectedCallback() {
      this.trigger?.removeEventListener('click', this.handleTriggerClick);
      this.trigger?.removeEventListener('keydown', this.handleTriggerKeyDown);
      this.options.forEach((option) =>
        option.removeEventListener('click', this.handleOptionClick),
      );
      this.options.forEach((option) =>
        option.removeEventListener('keydown', this.handleOptionKeyDown),
      );
      document.removeEventListener(
        'pointerdown',
        this.handleDocumentPointerDown,
      );
      document.removeEventListener('keydown', this.handleDocumentKeyDown);
    }

    openMenu(target: 'active' | 'first' | 'last' = 'active') {
      if (!this.menu || !this.trigger) return;
      this.menu.hidden = false;
      this.dataset.open = 'true';
      this.trigger.setAttribute('aria-expanded', 'true');

      const activeOption =
        this.options.find((option) => option.dataset.active === 'true') ||
        this.options[0];
      const fallbackOption =
        target === 'last'
          ? this.options[this.options.length - 1]
          : this.options[0];
      (target === 'active' ? activeOption : fallbackOption)?.focus();
    }

    toggleMenu() {
      if (this.menu?.hidden) {
        this.openMenu();
        return;
      }
      this.closeMenu();
    }

    closeMenu() {
      if (!this.menu || !this.trigger) return;
      this.menu.hidden = true;
      this.dataset.open = 'false';
      this.trigger.setAttribute('aria-expanded', 'false');
    }
  }

  if (!customElements.get('docs-theme-select')) {
    customElements.define('docs-theme-select', DocsThemeSelect);
  }
</script>
