{
  "name": "noverse.dev",
  "private": true,
  "type": "module",
  "workspaces": [
    "docs"
  ],
  "scripts": {
    "build": "npm run build:main && npm run build:docs",
    "build:docs": "npm run build --workspace noverse-docs",
    "predev": "node scripts/prep-docs-for-dev.mjs",
    "dev": "astro dev",
    "build:main": "astro build && node scripts/build-image-variants.mjs",
    "check": "astro check",
    "preview": "astro preview"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "astro": "^6.0.2",
    "sharp": "0.34.5",
    "typescript": "^5.9.3"
  }
}
