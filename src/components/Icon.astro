---
export type IconName =
  | 'book'
  | 'chevron-down'
  | 'chevron-left'
  | 'chevron-right'
  | 'copyright'
  | 'discord'
  | 'discord-brand'
  | 'github'
  | 'home'
  | 'key'
  | 'layout-column'
  | 'layout-row'
  | 'list'
  | 'mail'
  | 'moon'
  | 'product'
  | 'projects'
  | 'repo'
  | 'search'
  | 'settings'
  | 'sidebar'
  | 'sun'
  | 'swap'
  | 'terminal'
  | 'tools'
  | 'tuta'
  | 'user-list'
  | 'x'
  | 'zen'
  | 'zen-exit'
  | 'zoom-in'
  | 'zoom-out';

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className } = Astro.props;
---

<span
  class:list={['icon', `icon-${name}`, className]}
  aria-hidden="true"
></span>
