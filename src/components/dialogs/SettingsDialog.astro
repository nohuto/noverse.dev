---
interface Props { prefix: 'diff' | 'policy' }
const { prefix } = Astro.props;
---
<div class="settings-modal" id={`${prefix}-settings-modal`} hidden>
  <div class="settings-dialog" id={`${prefix}-settings-dialog`} role="dialog" aria-modal="true" aria-labelledby={`${prefix}-settings-title`}>
    <div class="settings-header" id={`${prefix}-settings-header`}>
      <h2 id={`${prefix}-settings-title`}>Settings</h2>
      <button id={`${prefix}-settings-close`} type="button" aria-label="Close settings" title="Close settings">
        <span class="settings-close-icon" aria-hidden="true"></span><span class="sr-only">Close settings</span>
      </button>
    </div>
    <slot />
    <div class="settings-footer">
      <button id={`${prefix}-settings-reset`} type="button">Reset</button>
      <button id={`${prefix}-settings-done`} type="button">Close</button>
    </div>
  </div>
</div>
