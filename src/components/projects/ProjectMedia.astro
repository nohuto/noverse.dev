---
import type { Project } from '../../data/projects';
import { webpWidths } from '../../utils/images';
interface Props {
  project: Project;
}
const { project } = Astro.props;
const poster = project.video
  ? await webpWidths(
      `/main/images/projects/posters/${project.video}.webp`,
      [960],
    )
  : null;
const image =
  !project.video && project.image
    ? await webpWidths(`${project.image}.png`, [480, 640, 960])
    : null;
---

{poster ? (
  <video
    class="project-media"
    src={`/main/media/projects/${project.video}.mp4`}
    poster={poster.byWidth[960]}
    width="2560"
    height="1440"
    controls
    preload="none"
    playsinline
    muted
  ></video>
) : image ? (
  <img
    decoding="async"
    class="project-media-img"
    src={image.byWidth[640]}
    srcset={image.srcset}
    sizes="(max-width: 700px) calc(100vw - 48px), (max-width: 1100px) 50vw, 430px"
    width={project.width}
    height={project.height}
    alt=""
    fetchpriority={project.priority ? 'high' : undefined}
    loading={project.priority ? undefined : 'lazy'}
    referrerpolicy={project.repo ? 'no-referrer' : undefined}
  />
) : null}
