---
import Icon from '../Icon.astro';
import ThemeControls from './ThemeControls.astro';
---

<a class="skip-link" href="#main">
  Skip to content
</a>
<header class="site-header">
  <nav class="site-nav nv-soft-backdrop" aria-label="Site">
    <a class="site-nav-text" href="/overview/">
      Main site
    </a>
    <span class="site-nav-divider" aria-hidden="true"></span>
    <a
      href="https://github.com/nohuto"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="GitHub"
      title="GitHub"
    >
      <Icon name="github" />
    </a>
    <button
      type="button"
      data-email="copy"
      data-toast="Email copied"
      aria-label="Copy email address"
      title="Copy email address"
    >
      <Icon name="mail" />
    </button>
    <a
      href="https://discord.noverse.dev"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Discord"
      title="Discord"
    >
      <Icon name="discord" />
    </a>
    <a
      href="https://pgp.noverse.dev"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Public PGP key"
      title="Public PGP key"
    >
      <Icon name="key" />
    </a>
    <span class="site-nav-divider" aria-hidden="true"></span>
    <ThemeControls />
  </nav>
</header>

<script>
  import { initClipboard } from '../../scripts/shell/clipboard';
  initClipboard();
</script>
