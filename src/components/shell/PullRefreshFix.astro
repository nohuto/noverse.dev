<script is:inline>
  if (
    / Brave$/.test(navigator.userAgent) &&
    performance.getEntriesByType('navigation')[0]?.type === 'reload'
  ) {
    const PULL_OFFSET_PX = 60;
    const SETTLE_DELAY_MS = 200;
    const WATCH_WINDOW_MS = 1500;
    const root = document.documentElement;
    const controller = new AbortController();
    const options = { passive: true, signal: controller.signal };
    let timer;
    const release = () => {
      controller.abort();
      if (!root.style.paddingTop) return;
      const top = scrollY - PULL_OFFSET_PX;
      root.style.paddingTop = '';
      scrollTo(0, top);
    };
    const onScroll = () => {
      if (scrollY < 0) root.style.paddingTop = `${PULL_OFFSET_PX}px`;
      clearTimeout(timer);
      timer = setTimeout(
        () => scrollY < PULL_OFFSET_PX && release(),
        SETTLE_DELAY_MS,
      );
    };
    addEventListener('scroll', onScroll, options);
    visualViewport?.addEventListener('scroll', onScroll, options);
    addEventListener('resize', release, options);
    setTimeout(
      () => root.style.paddingTop || controller.abort(),
      WATCH_WINDOW_MS,
    );
  }
</script>
