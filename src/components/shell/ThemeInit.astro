---
import {
  BG_KEY,
  DEFAULT_BG,
  backgrounds,
  DEFAULT_DARK_THEME,
  DEFAULT_LIGHT_THEME,
  THEME_KEY,
  THEME_SYSTEM,
  lightThemes,
  themes,
} from '../../data/themes';
import palette from '../../styles/palette.css?raw';

interface Props {
  background?: '--bg' | '--panel';
}
const { background = '--bg' } = Astro.props;
const backgroundIn = (selector: string) =>
  palette
    .split('}')
    .find((block) => block.includes(selector))
    ?.match(new RegExp(`${background}:\\s*([^;]+);`))?.[1]
    ?.trim();
const themeColors = Object.fromEntries(
  themes
    .map(([value]) => [
      value,
      value === DEFAULT_DARK_THEME
        ? backgroundIn(':root,')
        : value === DEFAULT_LIGHT_THEME
          ? backgroundIn(":root[data-theme='light']")
          : backgroundIn(`:root[data-theme-setting='${value}']`),
    ])
    .filter(([, color]) => color),
);
---

<meta
  name="theme-color"
  content={themeColors[DEFAULT_DARK_THEME]}
  data-background={background}
/>

<script
  is:inline
  define:vars={{
    themeKey: THEME_KEY,
    themeOptions: themes.map(([value]) => value),
    systemTheme: THEME_SYSTEM,
    darkTheme: DEFAULT_DARK_THEME,
    lightTheme: DEFAULT_LIGHT_THEME,
    lightOptions: [...lightThemes],
    bgKey: BG_KEY,
    bgOptions: backgrounds,
    defaultBg: DEFAULT_BG,
    themeColors,
  }}
>
  {
    const read = (key) => {
      try {
        return (localStorage.getItem(key) || '').trim();
      } catch {
        return '';
      }
    };
    const root = document.documentElement;
    const saved = read(themeKey);
    const setting = themeOptions.includes(saved) ? saved : systemTheme;
    const palette =
      setting === systemTheme
        ? matchMedia('(prefers-color-scheme: light)').matches
          ? lightTheme
          : darkTheme
        : setting;
    root.dataset.themeSetting = setting;
    root.dataset.theme = lightOptions.includes(palette) ? 'light' : 'dark';
    document
      .querySelector('meta[name="theme-color"]')
      ?.setAttribute('content', themeColors[palette]);
    const background = read(bgKey);
    root.dataset.bg = bgOptions.includes(background) ? background : defaultBg;
  }
</script>
