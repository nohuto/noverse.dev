---
import Icon from '../Icon.astro';
import IconLinks from './IconLinks.astro';
import KeyboardShortcuts from './KeyboardShortcuts.astro';
import Search from './Search.astro';
import ThemeControls from '../shell/ThemeControls.astro';
import SectionLinks from './SectionLinks.astro';
---

<div class="header">
  <div class="title-wrapper sl-flex">
    <button
      type="button"
      class="icon-button sidebar-toggle"
      aria-label="Collapse sidebar"
      aria-keyshortcuts="Control+Shift+S"
      aria-expanded="true"
      aria-controls="starlight__sidebar"
      data-tip="Ctrl+Shift+S"
      data-sidebar-toggle
    >
      <Icon name="sidebar" />
    </button>
  </div>
  <SectionLinks class="mobile-section-links" />
  <span class="header-divider mobile-divider" aria-hidden="true"></span>
  <div class="search-wrapper sl-flex print:hidden">
    <Search />
  </div>
  <div class="sl-hidden md:sl-flex print:hidden right-group">
    <IconLinks />
    <KeyboardShortcuts />
    <span class="header-divider" aria-hidden="true"></span>
    <ThemeControls />
  </div>
</div>

<style>
  @layer starlight.core {
    :global(:root) {
      --sl-nav-height: 2.875rem;
      --sl-nav-pad-y: 0.375rem;
    }

    @media (min-width: 50rem) {
      :global(:root) {
        --sl-nav-pad-x: 1.25rem;
      }
    }

    .header {
      display: flex;
      gap: var(--sl-nav-gap);
      justify-content: space-between;
      align-items: center;
      height: 100%;
    }

    .title-wrapper {
      padding: 0.125rem;
      margin: -0.125rem;
      min-width: 0;
      gap: 0.625rem;
      flex-shrink: 0;
    }

    .search-wrapper {
      min-width: 0;
    }

    @media not (min-width: 50rem) {
      :global(:root) {
        --sl-nav-gap: 4px;
      }
      .header :global(.mobile-section-links) {
        margin-inline-start: auto;
      }
      .mobile-divider {
        margin-inline: 5px;
      }
    }
    @media (min-width: 50rem) {
      .mobile-divider {
        display: none;
      }
    }

    @media (min-width: 50rem) {
      .header {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
      }
      .title-wrapper {
        justify-self: start;
      }
      .search-wrapper {
        width: clamp(12rem, 30vw, 22rem);
        margin: 0;
      }
      .right-group {
        justify-self: end;
      }
    }

    .right-group {
      --header-control-gap: 0.75rem;
      align-items: center;
      gap: var(--header-control-gap);
      padding-inline-end: 0.5rem;
    }

    .header :global(.icon-button) {
      width: var(--icon-size);
      height: var(--header-control-height);
    }

    .header-divider {
      flex: none;
      width: 1px;
      height: var(--header-control-height);
      background-color: var(--separator);
    }
  }

  .right-group :global(.theme-toggle) {
    width: var(--icon-size);
    height: var(--header-control-height);
  }
</style>
