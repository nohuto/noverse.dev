---
import IconLinks from './IconLinks.astro';
import ThemeControls from '../shell/ThemeControls.astro';
---

<div class="mobile-preferences sl-flex">
  <div class="mobile-links">
    <IconLinks />
  </div>
  <ThemeControls />
</div>

<style>
  .mobile-preferences {
    position: relative;
    justify-content: space-between;
    flex-wrap: wrap;
    align-items: center;
    border-top: 1px solid var(--sl-color-gray-6);
    column-gap: 0.75rem;
    row-gap: 0.625rem;
    padding: 0.5rem 0;
  }

  .mobile-links {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-width: 0;
    margin-inline-end: auto;
  }

  .mobile-links :global(.icon-button) {
    min-width: 1.75rem;
    min-height: 1.75rem;
    padding: 0.25rem;
  }
</style>
