---
import Default from '@astrojs/starlight/components/PageFrame.astro';
import Icon from '../ui/Icon.astro';
import Background from '../shell/Background.astro';
import ImageViewer from '../ImageViewer.astro';
import CodeFullscreen from '../CodeFullscreen.astro';
import {
  SIDEBAR_DEFAULT_WIDTH,
  SIDEBAR_MAX_WIDTH,
  SIDEBAR_MIN_WIDTH,
} from '../../utils/sidebar-width';
const { hasSidebar } = Astro.locals.starlightRoute;
---

<Background />
<ImageViewer />
<Default>
  <slot name="header" slot="header" />
  <slot name="sidebar" slot="sidebar" />
  <slot />
</Default>
{hasSidebar && (
  <div
    class="sidebar-resizer"
    role="separator"
    tabindex="0"
    aria-label="Resize sidebar"
    aria-orientation="vertical"
    aria-controls="starlight__sidebar"
    aria-valuemin={SIDEBAR_MIN_WIDTH}
    aria-valuemax={SIDEBAR_MAX_WIDTH}
    aria-valuenow={SIDEBAR_DEFAULT_WIDTH}
  ></div>
)}
<button
  type="button"
  class="icon-button soft-backdrop zen-exit"
  aria-label="Exit Zen mode"
  aria-keyshortcuts="Control+Shift+X"
  data-tip="Ctrl+Shift+X"
  data-zen-toggle
>
  <Icon name="arrows-in" />
</button>
<button
  type="button"
  class="scroll-to-top-button"
  aria-label="Scroll to top"
  title="Scroll to top"
>
  <Icon name="caret-double-up" />
</button>
<script>
  import '../../scripts/site-shell';
  import '../../scripts/tooltips';
</script>
{Astro.url.pathname.startsWith('/docs/') && <CodeFullscreen />}
