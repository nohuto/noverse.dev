---
const pagefindTranslations = {
  placeholder: '',
  ...Object.fromEntries(
    Object.entries(Astro.locals.t.all())
      .filter(([key]) => key.startsWith('pagefind.'))
      .map(([key, value]) => [key.replace('pagefind.', ''), value]),
  ),
};

const dataAttributes: DOMStringMap = {
  'data-translations': JSON.stringify(pagefindTranslations),
};
---

<site-search class={Astro.props.class} {...dataAttributes}>
  <button
    data-open-modal
    disabled
    aria-label={Astro.locals.t('search.label')}
    aria-keyshortcuts="Control+K"
  >
    <span class="search-button-icon" aria-hidden="true"></span>
    <kbd class="sl-hidden md:sl-flex" aria-hidden="true">
      <kbd>{Astro.locals.t('search.ctrlKey')}</kbd>
      <kbd>K</kbd>
    </kbd>
  </button>

  <dialog aria-label={Astro.locals.t('search.label')}>
    <div class="dialog-frame sl-flex">
      <button data-close-modal class="sl-flex md:sl-hidden">
        {Astro.locals.t('search.cancelLabel')}
      </button>
      {import.meta.env.DEV ? (
        <div class="search-dev-warning" dir="ltr">
          <p>{Astro.locals.t('search.devWarning')}</p>
        </div>
      ) : (
        <div class="search-container">
          <div id="starlight__search" />
        </div>
      )}
    </div>
  </dialog>
</site-search>

<script is:inline>
  (() => {
    const openBtn = document.querySelector('button[data-open-modal]');
    const shortcut = openBtn?.querySelector('kbd');
    if (!openBtn || !(shortcut instanceof HTMLElement)) return;
    const platformKey = shortcut.querySelector('kbd');
    if (platformKey && /(Mac|iPhone|iPod|iPad)/i.test(navigator.platform)) {
      platformKey.textContent = '⌘';
      openBtn.setAttribute('aria-keyshortcuts', 'Meta+K');
    }
    shortcut.style.display = '';
  })();
</script>

<script>
  import { withZenMode } from '../../utils/zen-mode';
  import { pagefindUserConfig } from 'virtual:starlight/pagefind-config';

  class SiteSearch extends HTMLElement {
    constructor() {
      super();
      const openBtn = this.querySelector<HTMLButtonElement>(
        'button[data-open-modal]',
      )!;
      const closeBtn = this.querySelector<HTMLButtonElement>(
        'button[data-close-modal]',
      )!;
      const dialog = this.querySelector('dialog')!;
      const dialogFrame = this.querySelector('.dialog-frame')!;
      document.body.append(dialog);

      const onClick = (event: MouseEvent) => {
        const isLink = 'href' in (event.target || {});
        if (
          isLink ||
          (document.body.contains(event.target as Node) &&
            !dialogFrame.contains(event.target as Node))
        ) {
          closeModal();
        }
      };

      const openModal = (event?: MouseEvent) => {
        dialog.showModal();
        document.body.toggleAttribute('data-search-modal-open', true);
        void loadPagefind().then(() => dialog.querySelector('input')?.focus());
        event?.stopPropagation();
        window.addEventListener('click', onClick);
      };

      const closeModal = () => dialog.close();

      openBtn.addEventListener('click', openModal);
      openBtn.addEventListener('pointerenter', () => void loadPagefind(), {
        once: true,
      });
      openBtn.addEventListener('focus', () => void loadPagefind(), {
        once: true,
      });
      openBtn.disabled = false;
      closeBtn.addEventListener('click', closeModal);

      dialog.addEventListener('close', () => {
        document.body.toggleAttribute('data-search-modal-open', false);
        window.removeEventListener('click', onClick);
      });

      window.addEventListener('keydown', (e) => {
        if (document.querySelector('dialog[open]') && !dialog.open) return;
        if (
          (e.metaKey || e.ctrlKey) &&
          !e.shiftKey &&
          !e.altKey &&
          e.key.toLowerCase() === 'k'
        ) {
          dialog.open ? closeModal() : openModal();
          e.preventDefault();
        }
      });

      let translations = {};
      try {
        translations = JSON.parse(this.dataset.translations || '{}');
      } catch {}

      let pagefindReady: Promise<void> | undefined;

      const loadPagefind = () => {
        if (import.meta.env.DEV) return Promise.resolve();
        pagefindReady ??= (async () => {
          // @ts-expect-error Missing types for @pagefind/default-ui package.
          const { PagefindUI } = await import('@pagefind/default-ui');
          new PagefindUI({
            ...pagefindUserConfig,
            element: '#starlight__search',
            baseUrl: import.meta.env.BASE_URL,
            bundlePath:
              import.meta.env.BASE_URL.replace(/\/$/, '') + '/pagefind/',
            autofocus: true,
            showImages: false,
            translations,
            showSubResults: false,
            processResult: (result: {
              url: string;
              sub_results: Array<{ url: string }>;
            }) => {
              result.url = withZenMode(result.url, new URL(location.href));
              result.sub_results = [];
              return result;
            },
          });
        })();
        return pagefindReady;
      };
    }
  }
  if (!customElements.get('site-search')) {
    customElements.define('site-search', SiteSearch);
  }
</script>

<style>
  @layer starlight.core {
    site-search {
      display: contents;
    }
    button[data-open-modal] {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      cursor: pointer;
      height: 2.5rem;
      font-size: var(--sl-text-xl);
    }

    .search-button-icon {
      width: min(1em, var(--icon-size));
      height: min(1em, var(--icon-size));
      background-color: currentColor;
      mask-image: var(--icon-search);
      mask-size: 100%;
    }

    @media (min-width: 50rem) {
      button[data-open-modal] {
        font-size: 0.78125rem;
        width: 100%;
      }

      button[data-open-modal] > :last-child {
        margin-inline-start: auto;
      }
    }

    kbd {
      font-family: var(--__sl-font);
    }

    .search-dev-warning {
      margin: auto;
      text-align: center;
      white-space: pre-line;
    }
    dialog {
      --sl-search-max-height: 100dvh;
      padding: 0;
      margin: 0;
      background-color: var(--sl-color-black);
      border: 1px solid var(--sl-color-gray-5);
      width: 100%;
      max-width: 100%;
      height: max-content;
      max-height: var(--sl-search-max-height);
    }
    dialog[open] {
      display: flex;
    }
    dialog:focus-within {
      border-color: var(--sl-color-accent);
    }

    dialog::backdrop {
      background-color: var(--sl-color-backdrop-overlay);
      -webkit-backdrop-filter: blur(0.25rem);
      backdrop-filter: blur(0.25rem);
    }

    .dialog-frame {
      position: relative;
      overflow: auto;
      flex-direction: column;
      flex-grow: 1;
    }

    button[data-close-modal] {
      position: absolute;
      z-index: 1;
      align-items: center;
      align-self: flex-end;
      height: calc(64px * var(--pagefind-ui-scale));
      padding: 0.25rem;
      border: 0;
      background: transparent;
      cursor: pointer;
      color: var(--sl-color-text-accent);
    }

    #starlight__search {
      --pagefind-ui-primary: var(--sl-color-text);
      --pagefind-ui-text: var(--sl-color-gray-2);
      --pagefind-ui-font: var(--__sl-font);
      --pagefind-ui-background: var(--sl-color-black);
      --pagefind-ui-border: var(--sl-color-gray-5);
      --pagefind-ui-border-width: 1px;
      --pagefind-ui-tag: var(--sl-color-gray-5);
      --sl-search-cancel-space: 5rem;
    }

    :root[data-theme='light'] #starlight__search {
      --pagefind-ui-tag: var(--sl-color-gray-6);
    }

    @media (min-width: 50rem) {
      #starlight__search {
        --sl-search-cancel-space: 0px;
      }

      dialog {
        --sl-search-max-height: calc(100dvh - 8rem);
        margin: 4rem auto auto;
        border-radius: var(--ui-radius);
        width: 90%;
        max-width: 40rem;
      }
    }
  }
</style>

<style is:global>
  @import url('@pagefind/default-ui/css/ui.css') layer(starlight.core);

  @layer starlight.core {
    [data-search-modal-open] {
      overflow: hidden;
    }

    #starlight__search {
      --sl-search-input-height: calc(64px * var(--pagefind-ui-scale));
      --sl-search-result-pad-inline-start: calc(
        3.75rem * var(--pagefind-ui-scale)
      );
      --sl-search-result-pad-inline-end: calc(
        1.25rem * var(--pagefind-ui-scale)
      );
      --sl-search-result-pad-block: calc(0.625rem * var(--pagefind-ui-scale));
      --pagefind-ui-border-radius: var(--ui-radius);
      --pagefind-ui-image-border-radius: var(--ui-radius);
      --sl-search-page-icon-size: calc(1.875rem * var(--pagefind-ui-scale));
      --sl-search-page-icon-inline-start: calc(
        (
            var(--sl-search-result-pad-inline-start) -
              var(--sl-search-page-icon-size)
          ) /
          2
      );
    }

    #starlight__search .pagefind-ui__form::before {
      display: none;
    }

    #starlight__search .pagefind-ui__search-input {
      color: var(--sl-color-white);
      font-weight: 400;
      width: calc(100% - var(--sl-search-cancel-space));
      height: var(--sl-search-input-height);
      padding-inline-start: var(--sl-search-page-icon-inline-start);
      border: 0;
      outline: none;
    }

    #starlight__search .pagefind-ui__search-input::placeholder {
      color: transparent;
    }

    #starlight__search .pagefind-ui__drawer {
      max-height: calc(
        var(--sl-search-max-height) - var(--sl-search-input-height) - 3px
      );
      overflow-y: auto;
      overscroll-behavior: contain;
      border-top: 1px solid var(--sl-color-gray-5);
    }

    #starlight__search .pagefind-ui__results-area {
      margin-top: 0;
    }

    #starlight__search .pagefind-ui__message {
      height: auto;
      padding: var(--sl-search-result-pad-block)
        var(--sl-search-page-icon-inline-start);
      font-weight: 400;
    }

    #starlight__search
      .pagefind-ui__results-area:has(.pagefind-ui__result)
      .pagefind-ui__message {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    #starlight__search .pagefind-ui__button {
      margin: 0;
      border: 0;
      border-top: 1px solid var(--sl-color-gray-5);
    }

    #starlight__search .pagefind-ui__search-clear {
      inset-inline-end: var(--sl-search-cancel-space);
      width: calc(60px * var(--pagefind-ui-scale));
      padding: 0;
      background-color: transparent;
      overflow: hidden;
    }
    #starlight__search .pagefind-ui__search-clear:focus {
      outline: 1px solid var(--sl-color-accent);
    }
    #starlight__search .pagefind-ui__search-clear::before {
      content: '';
      mask: var(--icon-x) center / 50% no-repeat;
      background-color: var(--sl-color-text-accent);
      display: block;
      width: 100%;
      height: 100%;
    }

    #starlight__search .pagefind-ui__result {
      position: relative;
      border: 0;
      padding: var(--sl-search-result-pad-block) 0;
    }

    #starlight__search .pagefind-ui__result:hover {
      background-color: color-mix(in srgb, var(--text) 10%, transparent);
    }

    #starlight__search .pagefind-ui__result:focus-within {
      background-color: var(--sl-color-accent-low);
    }

    #starlight__search .pagefind-ui__result-thumb,
    #starlight__search .pagefind-ui__result-inner {
      margin-top: 0;
    }

    #starlight__search .pagefind-ui__result-inner > .pagefind-ui__result-title {
      display: flex;
      align-items: center;
      gap: var(--sl-search-page-icon-inline-start);
      padding-inline: var(--sl-search-page-icon-inline-start)
        var(--sl-search-result-pad-inline-end);
    }
    #starlight__search
      .pagefind-ui__result-inner
      > .pagefind-ui__result-title::before {
      content: '';
      flex: none;
      width: var(--sl-search-page-icon-size);
      height: var(--sl-search-page-icon-size);
      background: var(--sl-color-gray-3);
      mask: var(--icon-file) center no-repeat;
    }

    #starlight__search .pagefind-ui__result-inner {
      align-items: stretch;
    }

    #starlight__search .pagefind-ui__result-link {
      position: unset;
      --pagefind-ui-text: var(--sl-color-white);
      font-weight: 600;
    }

    #starlight__search .pagefind-ui__result-link:hover {
      text-decoration: none;
    }

    #starlight__search .pagefind-ui__result-link::after {
      content: '';
      position: absolute;
      inset: 0;
    }

    [dir='rtl'] .pagefind-ui__result-title::before {
      transform: matrix(-1, 0, 0, 1, 0, 0);
    }

    #starlight__search .pagefind-ui__result-excerpt {
      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
      overflow: hidden;
      padding-inline: var(--sl-search-result-pad-inline-start)
        var(--sl-search-result-pad-inline-end);
      font-size: calc(1rem * var(--pagefind-ui-scale));
      overflow-wrap: anywhere;
    }

    #starlight__search mark {
      color: var(--sl-color-accent);
      background-color: transparent;
      font-weight: 600;
    }

    #starlight__search .pagefind-ui__filter-value::before {
      border-color: var(--sl-color-text-invert);
    }

    #starlight__search .pagefind-ui__result-tags {
      background-color: var(--sl-color-black);
      margin-top: 0;
      padding: calc(0.625rem * var(--pagefind-ui-scale))
        var(--sl-search-result-pad-inline-end);
    }
  }
</style>
