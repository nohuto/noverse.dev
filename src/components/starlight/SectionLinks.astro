---
import Icon, { type IconName } from '../ui/Icon.astro';
interface Props {
  class: string;
}
const links: [string, string, IconName][] = [
  ['Home', '/overview/', 'house'],
  ['Product', '/product/', 'windows-logo'],
  ['Projects', '/projects/', 'git-branch'],
  ['Web Tools', '/tools/', 'wrench'],
  ['Documentation', '/docs/', 'books'],
];
---

<nav class={Astro.props.class} aria-label="Main sections">
  {links.map(([label, href, icon]) => (
    <a class="icon-button" href={href} aria-label={label} title={label}>
      <Icon name={icon} />
    </a>
  ))}
</nav>
