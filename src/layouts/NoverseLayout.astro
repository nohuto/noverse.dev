---
import Header from '../components/shell/Header.astro';
import ThemeInit from '../components/shell/ThemeInit.astro';
import ImageViewer from '../components/ImageViewer.astro';
import Icon from '../components/Icon.astro';
import ScrollDebug from '../components/ScrollDebug.astro';
import '../styles/site.css';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en" data-theme-setting="system" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <ThemeInit />
    <script is:inline>
      // Braves pull to refresh can shift the page after pageshow
      if (
        performance.getEntriesByType('navigation')[0]?.type === 'reload' &&
        !location.hash
      ) {
        const restoration = history.scrollRestoration;
        const controller = new AbortController();
        history.scrollRestoration = 'manual';
        const reset = () => {
          if (scrollY > 0) window.scrollTo({ top: 0, behavior: 'instant' });
        };
        const stop = () => {
          history.scrollRestoration = restoration;
          controller.abort();
        };
        window.addEventListener('pageshow', reset, {
          once: true,
          signal: controller.signal,
        });
        window.addEventListener('scroll', reset, {
          passive: true,
          signal: controller.signal,
        });
        for (const type of [
          'touchstart',
          'pointerdown',
          'wheel',
          'keydown',
          'pagehide',
          'hashchange',
        ])
          window.addEventListener(type, stop, {
            once: true,
            passive: true,
            capture: true,
            signal: controller.signal,
          });
      }
    </script>
    <ScrollDebug />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" href="/favicon.png" type="image/png" sizes="64x64" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link
      rel="preload"
      href="/main/fonts/InterVariable-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body class="site-content">
    <div class="site-art" aria-hidden="true"></div>
    <Header />
    <slot />
    <footer class="site-footer">
      <Icon name="copyright" />
      {new Date().getFullYear()} nohuto
    </footer>
    <ImageViewer />
    <script>
      const art = document.querySelector<HTMLElement>('.site-art');
      const main = document.querySelector('main');
      const start = () =>
        import('../scripts/art/substrate').then(({ mountArt }) =>
          mountArt(art!, main!),
        );
      if (art && main)
        'requestIdleCallback' in window
          ? requestIdleCallback(start, { timeout: 2000 })
          : setTimeout(start, 200);
    </script>
  </body>
</html>
