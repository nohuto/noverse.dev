---
import Header from '../components/shell/Header.astro';
import ThemeInit from '../components/shell/ThemeInit.astro';
import PullRefreshFix from '../components/shell/PullRefreshFix.astro';
import ImageViewer from '../components/ImageViewer.astro';
import Icon from '../components/Icon.astro';
import '../styles/site.css';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en" data-theme-setting="system" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <ThemeInit />
    <PullRefreshFix />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" href="/favicon.png" type="image/png" sizes="64x64" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link
      rel="preload"
      href="/main/fonts/InterVariable-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body class="site-content">
    <div class="site-art" aria-hidden="true"></div>
    <Header />
    <slot />
    <footer class="site-footer">
      <Icon name="copyright" />
      {new Date().getFullYear()} nohuto
    </footer>
    <ImageViewer />
    <script>
      import '../scripts/tooltips';

      const art = document.querySelector<HTMLElement>('.site-art');
      const main = document.querySelector('main');
      const start = () =>
        import('../scripts/art/substrate').then(({ mountArt }) =>
          mountArt(art!, main!),
        );
      if (art && main)
        'requestIdleCallback' in window
          ? requestIdleCallback(start, { timeout: 2000 })
          : setTimeout(start, 200);
    </script>
  </body>
</html>
