---
import Icon from '../components/Icon.astro';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import '../styles/widgets.css';
import SettingsDialog from '../components/dialogs/SettingsDialog.astro';
import '../styles/diff.css';
---

<StarlightPage
  frontmatter={{
    title: 'Pseudocode, Type Layout & Globals Diff',
    description: 'Compare decompiled pseudocode, type layouts, and globals',
    tableOfContents: false,
  }}
>
  <div class="site-content not-content bindiff-main">
    <section id="diff-app" aria-busy="true">
      <div class="panel-body">
        <div class="bindiff-intro">
          <!-- prettier-ignore -->
          <p>
            Compare or display (shows content of left build)
            <a class="link" href="https://github.com/nohuto/decompiled-pseudocode" target="_blank" rel="noopener noreferrer">decompiled pseudocode</a>,
            <a class="link" href="https://github.com/nohuto/type-layouts" target="_blank" rel="noopener noreferrer">type layouts</a>,
            or
            <a class="link" href="https://github.com/nohuto/globals" target="_blank" rel="noopener noreferrer">globals</a>
            (note that the PE init value doesn't always equal the current value
            as it may change, see repo for an example) of different modules
            &amp; builds.
          </p>
        </div>

        <div class="bindiff-controls">
          <div class="bindiff-grid diff-grid">
            <div class="bindiff-field bindiff-field-compact diff-build-field">
              <label for="diff-left-release">Left build</label>
              <select
                class="select-enhanced"
                id="diff-left-release"
                name="left-release"
              >
                <option value=""></option>
              </select>
            </div>
            <div class="bindiff-field bindiff-field-compact diff-build-field">
              <label for="diff-right-release">Right build</label>
              <select
                class="select-enhanced"
                id="diff-right-release"
                name="right-release"
              >
                <option value=""></option>
              </select>
            </div>
            <div class="bindiff-field bindiff-field-compact diff-kind-field">
              <div
                class="diff-kind-toggle"
                id="diff-kind-toggle"
                role="group"
                aria-label="Diff source"
              >
                <button
                  class="is-active"
                  type="button"
                  data-kind="type"
                  aria-pressed="true"
                >
                  Type
                </button>
                <button type="button" data-kind="globals" aria-pressed="false">
                  Globals
                </button>
                <button
                  type="button"
                  data-kind="pseudocode"
                  aria-pressed="false"
                >
                  Pseudocode
                </button>
              </div>
            </div>
            <div class="bindiff-field bindiff-field-compact diff-module-field">
              <label for="diff-module">Module</label>
              <select class="select-enhanced" id="diff-module" name="module">
                <option value=""></option>
              </select>
            </div>
            <div class="bindiff-field bindiff-field-compact diff-name-field">
              <label for="diff-name">Type</label>
              <select
                class="select-enhanced"
                data-searchable="true"
                id="diff-name"
                name="name"
              >
                <option value=""></option>
              </select>
            </div>
          </div>

          <div class="bindiff-output-tools">
            <div class="bindiff-actions">
              <button id="diff-display" type="button" disabled>
                Display
              </button>
              <button id="diff-run" type="button" disabled>
                Compare
              </button>
            </div>
          </div>
        </div>

        <div class="bindiff-output-frame">
          <div class="bindiff-toolbar">
            <div
              class="bindiff-view-tools bindiff-frame-view-tools"
              id="diff-view-tools"
            >
              <div
                class="bindiff-view-toggle"
                aria-label="View mode"
                id="diff-view-mode"
                role="group"
              >
                <button
                  class="bindiff-view-button is-active"
                  type="button"
                  data-mode="side-by-side"
                  aria-label="Side by side"
                  title="Side by side"
                  aria-pressed="true"
                >
                  <Icon name="layout-column" />
                </button>
                <button
                  class="bindiff-view-button"
                  type="button"
                  data-mode="line-by-line"
                  aria-label="Line by line"
                  title="Line by line"
                  aria-pressed="false"
                >
                  <Icon name="layout-row" />
                </button>
              </div>
            </div>
            <div class="bindiff-font-tools" id="diff-font-tools">
              <button
                class="bindiff-icon-button"
                id="diff-font-decrease"
                type="button"
                aria-label="Decrease font size"
                title="Decrease font size"
              >
                <Icon name="zoom-out" />
              </button>
              <button
                class="bindiff-icon-button"
                id="diff-font-increase"
                type="button"
                aria-label="Increase font size"
                title="Increase font size"
              >
                <Icon name="zoom-in" />
              </button>
            </div>
            <button
              class="bindiff-icon-button"
              id="diff-swap"
              type="button"
              aria-label="Swap builds"
              title="Swap builds"
            >
              <Icon name="swap" />
            </button>
            <button
              class="bindiff-icon-button"
              id="diff-settings"
              type="button"
              aria-label="Settings"
              title="Settings"
              disabled
            >
              <Icon name="settings" />
            </button>
            <button
              class="bindiff-icon-button"
              id="diff-maximize"
              type="button"
              aria-pressed="false"
              aria-label="Maximize"
              title="Maximize"
            >
              <Icon name="zen" class="icon-maximize" />
              <Icon name="zen-exit" class="icon-minimize" />
            </button>
          </div>
          <div id="diff-output" class="bindiff-output" aria-live="off"></div>
        </div>

        <SettingsDialog prefix="diff">
          <div class="settings-body" id="diff-settings-body"></div>
        </SettingsDialog>

        <div class="bindiff-links" id="diff-links" hidden>
          <a
            id="diff-left-link"
            class="link"
            href="#"
            target="_blank"
            rel="noopener noreferrer"
          >
            Left source
          </a>
          <a
            id="diff-right-link"
            class="link"
            href="#"
            target="_blank"
            rel="noopener noreferrer"
          >
            Right source
          </a>
        </div>
      </div>
    </section>
  </div>
  <script>
    import '../scripts/diff/diff';
  </script>
</StarlightPage>
