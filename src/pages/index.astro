---
import NoverseLayout from '../layouts/NoverseLayout.astro';
import HomeProjects from '../components/projects/HomeProjects.astro';
import commits from '../data/commits.json';
import homeStyles from '../styles/home.css?url';

const dateFormatter = new Intl.DateTimeFormat('en', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
  timeZone: 'UTC',
});
---

<NoverseLayout
  title="Home - Noverse"
  description="Current work, latest activity"
  page="index"
  styles={[homeStyles]}
>
  <main id="main" class="home-main">
    <section class="content-box panel home-page" data-title="home">
      <div class="panel-body">
        <header class="home-intro">
          <h1>nohuto</h1>
          <p>
            I'm currently studying (and partly documenting, often in relation to
            registry values) Windows internals, with an interest in debugging
            and static analysis. I also spend some time with online privacy
            &amp; security. Note that Noverse is an independent entity, solely
            managed by me. No one else works for/with me under this name.
          </p>
          <!-- prettier-ignore -->
          <p class="home-contact">
            You can contact me at
            <button
              class="home-email"
              type="button"
              data-email
              data-email-text
              data-toast="Email copied"
              aria-label="Copy email address"
            ></button>
            or via
            <a class="link" href="https://discord.noverse.dev" target="_blank" rel="noopener noreferrer">discord</a>,
            my public key is available
            <a class="link" href="/public.asc" type="application/pgp-keys" download>here</a>.
          </p>
        </header>

        <section class="home-section" aria-labelledby="active-work-title">
          <div class="section-heading">
            <h2 id="active-work-title">Active work</h2>
          </div>
          <div class="home-work-grid">
            <HomeProjects />
          </div>
        </section>

        <section
          class="home-section"
          id="home-commits"
          aria-labelledby="latest-commits-title"
        >
          <div class="section-heading">
            <h2 id="latest-commits-title">Latest commits</h2>
          </div>
          <div class="commit-list">
            {commits.length ? (
              commits.map((commit) => (
                <a
                  class="commit-item"
                  href={commit.url}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <span class="commit-repo">
                    {commit.repo} <span class="commit-sha">{commit.sha}</span>
                  </span>
                  <span class="commit-message">{commit.message}</span>
                  <time class="commit-date" datetime={commit.date}>
                    {dateFormatter.format(new Date(commit.date))}
                  </time>
                </a>
              ))
            ) : (
              <p class="home-status">No recent commits available</p>
            )}
          </div>
        </section>
      </div>
    </section>
  </main>
</NoverseLayout>
