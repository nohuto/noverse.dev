---
import PortfolioLayout from '../layouts/PortfolioLayout.astro';
import Icon from '../components/Icon.astro';
import ProjectMedia from '../components/projects/ProjectMedia.astro';
import { projects } from '../data/projects';
import '../styles/home.css';

const selected = projects
  .filter((project) => project.home)
  .sort((left, right) => left.home!.order - right.home!.order);
---

<PortfolioLayout title="nohuto" description="Current work and projects">
  <main id="main" class="home-main">
    <section>
      <header class="home-intro">
        <h1>nohuto</h1>
        <!-- prettier-ignore -->
        <p>
          I'm currently studying (and partly
          <a class="link" href="/docs/">documenting</a>, often in relation to
          registry values) Windows internals, with an interest in debugging and
          static analysis. I also spend some time with online privacy &amp;
          security. Note that Noverse is an independent entity, solely managed
          by me. No one else works for/with me under this name.
        </p>
        <!-- prettier-ignore -->
        <p class="home-contact">
            You can contact me at
            <button
              class="home-email link"
              type="button"
              data-email
              data-toast="Email copied"
              title="Copy email address"
            ><Icon name="tuta" /><span data-email-text></span></button>
            or via
            <a class="link" href="https://discord.noverse.dev" target="_blank" rel="noopener noreferrer"><Icon name="discord-brand" />discord</a>,
            my public key is available
            <a class="link" href="https://pgp.noverse.dev">here</a>.
          </p>
        <!-- prettier-ignore -->
        <p>
          Find a list of projects, documentation etc. on the
          <a class="link" href="/overview/">main site</a>.
        </p>
      </header>

      <hr class="home-rule" />

      <section class="home-work" aria-labelledby="selected-work-title">
        <h2 id="selected-work-title">Selected work</h2>
        {selected.map((project) => (
          <article class="work">
            <h3>
              <a
                class="link"
                href={`https://github.com/${project.repo}`}
                target="_blank"
                rel="noopener noreferrer"
              >
                {project.title}
              </a>
            </h3>
            <details class="work-preview">
              <summary
                aria-label={`Show ${project.title} preview`}
                title="Show preview"
              >
                <Icon name="chevron-down" />
              </summary>
              <ProjectMedia
                project={project}
                sizes="(max-width: 656px) calc(100vw - 56px), 600px"
              />
            </details>
            <p class="work-desc">{project.description}</p>
          </article>
        ))}
        <a class="home-more link" href="/projects/">
          Show all projects
        </a>
      </section>
    </section>
  </main>
</PortfolioLayout>
