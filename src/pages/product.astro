---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import Icon from '../components/Icon.astro';
import '../styles/widgets.css';
import '../styles/product.css';
import '../styles/section-heading.css';
import { webpWidths } from '../utils/images';
import paypalMethods from '../image-sources/main/images/paypal-methods.svg?url';

const preview = async (name: string, label: string, linkOriginal = true) => {
  const image = await webpWidths(`/main/images/${name}.png`, [640, 960]);
  return {
    label,
    image,
    href: linkOriginal ? image.source.src : image.byWidth[960],
  };
};
const previews = await Promise.all([
  preview('darkbluelogs', 'dark mode blue logs', false),
  preview('lightblue', 'light mode blue'),
  preview('lightviolet', 'light mode violet'),
  preview('darkred', 'dark mode red'),
]);
---

<StarlightPage
  frontmatter={{
    title: 'Windows Configuration',
    description: 'Windows Configuration product',
  }}
  headings={[
    { depth: 2, slug: 'terms', text: 'Miscellaneous Information' },
    { depth: 3, slug: 'refund-policy', text: 'Refund Policy' },
    { depth: 3, slug: 'license', text: 'License' },
    { depth: 3, slug: 'data-privacy', text: 'Data Privacy' },
    { depth: 3, slug: 'usage-redistribution', text: 'Usage & Redistribution' },
    { depth: 3, slug: 'after-purchase', text: 'After Purchase' },
  ]}
>
  <div class="site-content not-content product-main">
    <section id="product">
      <div class="product-overview">
        <div class="product-details">
          <div class="product-intro">
            <p>
              A tool for modifying your system alongside my documentation
              (reading it isn't required, as each section includes templates),
              whether you follow my choices or test your own.
            </p>
          </div>
          <ul class="product-highlights">
            <li>Transparent logs for each change</li>
            <li>
              <a class="link" href="/docs/win-config/">
                Documentation
              </a>{' '}
              for each option
            </li>
            <li>Templates for each section</li>
          </ul>
        </div>
        <div
          class="product-gallery"
          role="region"
          aria-label="Product screenshots"
          aria-roledescription="carousel"
        >
          <div
            class="product-slides"
            id="product-slides"
            tabindex="0"
            role="group"
            aria-label="Screenshots, use left and right arrow keys"
          >
            {previews.map(({ label, href, image }, index) => (
              <a
                class="product-slide"
                href={href}
                data-image-view={`WinConfig in ${label}`}
                aria-label={`Open full-size ${label} screenshot`}
              >
                <img
                  decoding="async"
                  src={image.byWidth[640]}
                  srcset={image.srcset}
                  sizes="(max-width: 759px) calc(100vw - 56px), 640px"
                  width={image.source.width}
                  height={image.source.height}
                  alt={`WinConfig in ${label}`}
                  loading={index === 0 ? 'eager' : 'lazy'}
                  fetchpriority={index === 0 ? 'high' : undefined}
                />
                <span class="image-expand" aria-hidden="true">
                  <Icon name="zen" />
                </span>
              </a>
            ))}
          </div>
          <button
            class="product-gallery-arrow previous"
            type="button"
            data-gallery-direction="-1"
            aria-label="Previous screenshot"
            aria-controls="product-slides"
            hidden
          >
            <Icon name="chevron-left" />
          </button>
          <button
            class="product-gallery-arrow next"
            type="button"
            data-gallery-direction="1"
            aria-label="Next screenshot"
            aria-controls="product-slides"
            hidden
          >
            <Icon name="chevron-right" />
          </button>
          <span
            id="product-gallery-status"
            class="sr-only"
            aria-live="polite"
            aria-atomic="true"
          >
            Screenshot 1 of {previews.length}
          </span>
        </div>
        <div class="product-purchase">
          <div class="product-cta">
            <div class="product-pricing">
              <span class="product-price">9,99&nbsp;EUR</span>
              <span class="price-label">Lifetime license</span>
            </div>
            <form
              action="https://www.paypal.com/ncp/payment/C4XUQMQZHS948"
              method="post"
              target="_blank"
            >
              <button class="paypal-button" type="submit">
                <span>Buy via</span>
                <img
                  decoding="async"
                  class="paypal-button-logo"
                  src={paypalMethods}
                  width="140"
                  height="20"
                  alt="PayPal"
                  loading="lazy"
                />
              </button>
            </form>
          </div>
          <!-- prettier-ignore -->
          <p class="purchase-note">
            Access is assigned manually via Discord, see <span class="purchase-reference">'<a
              class="link"
              href="#after-purchase">After Purchase</a>'</span> for more.
          </p>
        </div>
        <div class="product-documentation">
          <p>
            WinConfig is based on my personal research on several topics, which
            I began documenting around July 2024. Purchasing a license supports
            my research and ongoing work. The detail of each options
            <a class="link" href="/docs/win-config/">
              documentation
            </a>
            depends on whether trustworthy public documentation exists.
          </p>
        </div>
      </div>

      <div class="product-terms">
        <div class="legal-section" id="terms">
          <div class="section-heading">
            <h2>Miscellaneous information</h2>
          </div>
          <div class="legal-list">
            <div class="legal-column">
              <details class="legal-item">
                <summary id="refund-policy">
                  Refund Policy
                  <Icon name="chevron-down" />
                </summary>
                <p>
                  Refunds are available only if no registration has been made
                  and no Discord role has been assigned. Include proof of
                  purchase when submitting a refund request.
                </p>
              </details>
              <details class="legal-item">
                <summary id="license">
                  License
                  <Icon name="chevron-down" />
                </summary>
                <p>
                  Each purchase includes one hardware bound license. Keys don't
                  transfer across devices without reregistration (which is
                  possible within certain limits). Updates and a Discord role
                  are included.
                </p>
              </details>
            </div>
            <div class="legal-column">
              <details class="legal-item">
                <summary id="data-privacy">
                  Data Privacy
                  <Icon name="chevron-down" />
                </summary>
                <p>
                  WinConfig uses three hardware identifiers for license
                  registration and verification, SMBIOS UUID, baseboard serial,
                  and CPU ID (with MAC address or device IDs as fallbacks).
                  Saved login data is stored locally, I don't have access to
                  your password.
                </p>
              </details>
              <details class="legal-item">
                <summary id="usage-redistribution">
                  Usage &amp; Redistribution
                  <Icon name="chevron-down" />
                </summary>
                <p>
                  Licenses are for personal use only. Reselling, transferring,
                  redistributing, or SRE of WinConfig is prohibited unless you
                  receive explicit written permission from me (nohuto). By
                  purchasing or using WinConfig, you accept these terms.
                </p>
              </details>
              <details class="legal-item">
                <summary>
                  After Purchase
                  <Icon name="chevron-down" />
                </summary>
                <p id="after-purchase">
                  To get access, you must either include your Discord ID in the
                  purchase message or send me your transaction ID so I can
                  assign the Discord role. The role isn't assigned
                  automatically, so one of these is required. Once the role is
                  assigned, you'll get access to a download link for the tool.
                  After downloading, you must register yourself via the tool,
                  and then I'll validate your registration (which may take some
                  time). Joining, or already being in the{' '}
                  <a
                    class="link"
                    href="https://discord.noverse.dev"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Discord server
                  </a>{' '}
                  is recommended for now so you receive updates, announcements,
                  and support. Otherwise you may miss app updates (config
                  updates would theoretically work as long as no new
                  section/helper gets added).
                </p>
              </details>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
  <script>
    import '../scripts/product/gallery';
  </script>
</StarlightPage>
