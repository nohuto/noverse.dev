---
import NoverseLayout from '../layouts/NoverseLayout.astro';
import productStyles from '../styles/product.css?url';
import { webpWidths } from '../utils/images';

const preview = async (name: string, label: string, linkOriginal = true) => {
  const image = await webpWidths(`/main/images/${name}.png`, [640, 960]);
  return {
    label,
    image,
    href: linkOriginal ? image.source.src : image.byWidth[960],
  };
};
const previews = await Promise.all([
  preview('darkbluelogs', 'dark mode blue logs', false),
  preview('lightblue', 'light mode blue'),
  preview('lightviolet', 'light mode violet'),
  preview('darkred', 'dark mode red'),
]);
---

<NoverseLayout
  title="Product - Noverse"
  description="Windows Configuration product"
  page="product"
  styles={[productStyles]}
>
  <main id="main">
    <section
      class="content-box panel product-page"
      id="product"
      data-title="product"
    >
      <div class="panel-body">
        <div class="product-section product-overview">
          <h1 class="page-heading">Windows Configuration</h1>
          <div class="page-divider"></div>
          <div class="product-header">
            <div class="product-intro">
              <p>
                WinConfig is based on my personal research on several topics,
                which I began documenting around July 2024. It has transparent
                logs so users can see every change, including the value name,
                data, type and, for recursive changes, the number of modified
                keys. Some options also show the executed PowerShell code.
              </p>
              <!-- prettier-ignore -->
              <p>
                Each option has its own
                <a class="link" href="/docs/win-config/">documentation</a>,
                some may be more detailed whenever theres no public
                (trustworthy) documentation on them, some less.
              </p>
              <p>
                These detailed notes are intended to be used for informational
                purposes and to help users understand what exactly an option
                changes. Reading/understanding the documentation isn't required
                to use the tool, as there're templates for each section.
              </p>
            </div>
            <div class="product-cta">
              <span class="price-label">Lifetime</span>
              <span class="product-price">9,99&nbsp;EUR</span>
              <p class="pricing-note">Includes updates &amp; Discord role.</p>
              <div class="purchase-actions">
                <form
                  class="paypal-form"
                  action="https://www.paypal.com/ncp/payment/C4XUQMQZHS948"
                  method="post"
                  target="_blank"
                >
                  <button class="paypal-button" type="submit">
                    <span>Buy via</span>
                    <img
                      decoding="async"
                      class="paypal-button-logo"
                      src="/main/images/paypal-methods.svg"
                      width="140"
                      height="20"
                      alt=""
                      loading="lazy"
                    />
                  </button>
                </form>
              </div>
            </div>
          </div>
          <div class="product-preview-grid">
            {previews.map(({ label, href, image }, index) => (
              <figure class="product-preview-card">
                <a
                  href={href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`Open ${label} preview`}
                >
                  <img
                    decoding="async"
                    src={image.byWidth[640]}
                    srcset={image.srcset}
                    sizes="(max-width: 700px) calc(100vw - 48px), 552px"
                    width="640"
                    height="387"
                    alt=""
                    loading={index === 0 ? 'eager' : 'lazy'}
                    fetchpriority={index === 0 ? 'high' : undefined}
                  />
                </a>
              </figure>
            ))}
          </div>
        </div>

        <div class="product-section product-terms">
          <div class="legal-section" id="terms">
            <h2 class="product-divider-heading legal-heading">
              Miscellaneous Information
            </h2>
            <div class="legal-list">
              <article class="legal-item">
                <h3>Data Privacy</h3>
                <p>
                  WinConfig uses three hardware identifiers for license
                  registration and verification, SMBIOS UUID, baseboard serial,
                  and CPU ID (with MAC address or device IDs as fallbacks).
                  Saved login data is stored locally, I don't have access to
                  your password.
                </p>
              </article>
              <article class="legal-item">
                <h3>Usage &amp; Redistribution</h3>
                <p>
                  Licenses are for personal use only. Reselling, transferring,
                  redistributing, or SRE of WinConfig is prohibited unless you
                  receive explicit written permission from me (nohuto). By
                  purchasing or using WinConfig, you accept these terms.
                </p>
              </article>
              <article class="legal-item">
                <h3>Refund Policy</h3>
                <p>
                  Refunds are available only if no registration has been made
                  and no Discord role has been assigned. Include proof of
                  purchase when submitting a refund request.
                </p>
              </article>
              <article class="legal-item">
                <h3>License</h3>
                <p>
                  Each purchase includes one hardware bound license. Keys do not
                  transfer across devices without reregistration (which is
                  possible within certain limits).
                </p>
              </article>
              <article class="legal-item">
                <h3>After Purchase</h3>
                <p>
                  To get access, you must either include your Discord ID in the
                  purchase message or send me your transaction ID so I can
                  assign the Discord role. The role isn't assigned
                  automatically, so one of these is required. Once the role is
                  assigned, you'll get access to a download link for the tool.
                  After downloading, you must register yourself via the tool,
                  and then I'll validate your registration (which may take some
                  time). Joining, or already being in the{' '}
                  <a
                    class="link"
                    href="https://discord.noverse.dev"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Discord server
                  </a>{' '}
                  is recommended for now so you receive updates, announcements,
                  and support. Otherwise you may miss app updates (config
                  updates would theoretically work as long as no new
                  section/helper gets added).
                </p>
              </article>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</NoverseLayout>
