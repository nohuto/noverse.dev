---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
---

<StarlightPage
  frontmatter={{
    title: 'Terms',
    description: 'WinConfig terms',
    tableOfContents: false,
  }}
>
  <p>WinConfig is sold by nohuto.</p>
  <p>
    Paddle.com is the reseller and Merchant of Record, which handles payment,
    invoices, taxes and refunds, and its buyer terms apply to the purchase.
  </p>
  <h2 id="your-license">Your license</h2>
  <ul>
    <li>One time payment</li>
    <li>
      The license belongs to the Discord account you bought it with and runs on
      one PC at a time. You can move it to another PC 3 times in any 30 days
      (more on request)
    </li>
    <li>WinConfig needs an internet connection</li>
    <li>
      Don't share, resell or crack the license, and don't copy WinConfig's
      content
    </li>
  </ul>
</StarlightPage>
