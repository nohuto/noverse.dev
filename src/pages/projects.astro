---
import NoverseLayout from '../layouts/NoverseLayout.astro';
import ProjectCards from '../components/projects/ProjectCards.astro';
import projectStyles from '../styles/projects.css?url';
import searchStyles from '../styles/search.css?url';
---

<NoverseLayout
  title="Projects - Noverse"
  description="My Open Source Projects"
  page="projects"
  styles={[projectStyles, searchStyles]}
>
  <main id="main">
    <section data-title="projects">
      <h1 class="page-heading">My Open Source Projects</h1>
      <div class="page-divider"></div>
      <div class="project-filter">
        <div class="filter-row">
          <div class="nv-search-box">
            <span class="nv-search-icon" aria-hidden="true"></span>
            <input
              id="project-search"
              type="text"
              aria-label="Search projects"
              aria-keyshortcuts="Control+K"
            />
            <kbd class="nv-search-shortcut" aria-hidden="true">
              <kbd>Ctrl</kbd>
              <kbd>K</kbd>
            </kbd>
          </div>
        </div>
        <nav class="project-section-links" aria-label="Project sections">
          <a class="link" href="#active-projects-title">
            Active projects
          </a>
          <a class="link" href="#resource-projects-title">
            Resource repos
          </a>
          <a class="link" href="#web-projects-title">
            Web tools
          </a>
          <a class="link" href="#powershell-projects-title">
            PowerShell tools
          </a>
          <a class="link" href="#website-projects-title">
            Websites
          </a>
          <a class="link" href="#misc-projects-title">
            Misc
          </a>
          <a class="link" href="#archive-projects-title">
            Archive
          </a>
        </nav>
      </div>
      <section class="project-group" aria-labelledby="active-projects-title">
        <div class="section-heading">
          <h2 id="active-projects-title">Active projects</h2>
        </div>
        <div class="project-grid">
          <ProjectCards section="active" />
        </div>
      </section>
      <section class="project-group" aria-labelledby="resource-projects-title">
        <div class="section-heading">
          <h2 id="resource-projects-title">Resource repos</h2>
        </div>
        <div class="project-grid">
          <ProjectCards section="resources" />
        </div>
      </section>
      <section class="project-group" aria-labelledby="web-projects-title">
        <div class="section-heading">
          <h2 id="web-projects-title">Web tools</h2>
        </div>
        <div class="project-grid">
          <ProjectCards section="web" />
        </div>
      </section>
      <section
        class="project-group"
        aria-labelledby="powershell-projects-title"
      >
        <div class="section-heading">
          <h2 id="powershell-projects-title">
            PS obfuscation / minification / conversion
          </h2>
        </div>
        <div class="project-grid">
          <ProjectCards section="powershell" />
        </div>
      </section>
      <section class="project-group" aria-labelledby="website-projects-title">
        <div class="section-heading">
          <h2 id="website-projects-title">Websites</h2>
        </div>
        <div class="project-grid">
          <ProjectCards section="websites" />
        </div>
      </section>
      <section class="project-group" aria-labelledby="misc-projects-title">
        <div class="section-heading">
          <h2 id="misc-projects-title">Misc</h2>
        </div>
        <div class="project-grid">
          <ProjectCards section="misc" />
        </div>
      </section>
      <section class="project-group" aria-labelledby="archive-projects-title">
        <div class="section-heading">
          <h2 id="archive-projects-title">Archive</h2>
        </div>
        <div class="project-grid">
          <ProjectCards section="archive" />
        </div>
      </section>
      <p class="project-empty" id="project-empty" hidden>
        No matching project(s)
      </p>
    </section>
  </main>
  <script>
    import '../scripts/projects/filter';
    import '../scripts/search/shortcut';
  </script>
</NoverseLayout>
