---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import Icon from '../components/Icon.astro';
import '../styles/widgets.css';
import ProjectCard from '../components/projects/ProjectCard.astro';
import { projects } from '../data/projects';
import '../styles/projects.css';
import '../styles/section-heading.css';
import '../styles/search.css';

const sections = [
  { section: 'active', id: 'active-projects-title', text: 'Active projects' },
  {
    section: 'resources',
    id: 'resource-projects-title',
    text: 'Resource repos',
  },
  { section: 'web', id: 'web-projects-title', text: 'Web Tools' },
  {
    section: 'powershell',
    id: 'powershell-projects-title',
    text: 'PS obfuscation / minification / conversion',
  },
  { section: 'websites', id: 'website-projects-title', text: 'Websites' },
  { section: 'misc', id: 'misc-projects-title', text: 'Misc' },
  { section: 'archive', id: 'archive-projects-title', text: 'Archive' },
];
---

<StarlightPage
  frontmatter={{
    title: 'Open Source Projects',
    description: 'Open Source Projects',
  }}
  headings={sections.map(({ id, text }) => ({ depth: 2, slug: id, text }))}
>
  <div class="site-content not-content">
    <section>
      <div class="project-filter">
        <div class="filter-row">
          <div class="nv-search-box">
            <Icon name="search" class="nv-search-icon" />
            <input
              id="project-search"
              type="text"
              aria-label="Search projects"
            />
          </div>
        </div>
      </div>
      {sections.map(({ section, id, text }) => (
        <section class="project-group" aria-labelledby={id}>
          <div class="section-heading">
            <h2 id={id}>{text}</h2>
          </div>
          <div class="project-grid">
            {projects
              .filter((project) => (project.section || 'active') === section)
              .map((project) => (
                <ProjectCard project={project} />
              ))}
          </div>
        </section>
      ))}
      <p class="project-empty" id="project-empty" hidden>
        No matching project(s)
      </p>
    </section>
  </div>
  <script>
    import '../scripts/projects/filter';
  </script>
</StarlightPage>
