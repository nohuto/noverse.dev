---
import Icon from '../components/Icon.astro';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import '../styles/widgets.css';
import '../styles/terminal.css';

const calcTools = [
  ['x<sup>2</sup>', '^2'],
  ['x<sup>y</sup>', '^'],
  ['abs', 'abs('],
  ['sqrt', 'sqrt('],
  ['log', 'log('],
  ['ln', 'ln('],
  ['sin', 'sin('],
  ['cos', 'cos('],
  ['tan', 'tan('],
  ['pi'],
  ['e'],
  [','],
  ['('],
  [')'],
];
const calcKeys = [...'789/456*123-0.', 'ans', '+'];
---

<StarlightPage
  frontmatter={{
    title: 'Terminal',
    description: 'Interactive terminal',
    tableOfContents: false,
  }}
>
  <div class="site-content not-content main-terminal">
    <section class="terminal-shell">
      <div class="window-surface">
        <div
          class="console-window"
          id="console-window"
          role="region"
          aria-label="Terminal window"
        >
          <div class="console-window-header" id="console-drag">
            <span class="console-window-title">
              <Icon name="terminal" class="console-window-icon" />
              <span>terminal</span>
            </span>
          </div>
          <div class="console-window-body">
            <div class="console" id="console">
              <div
                class="console-output"
                id="console-output"
                role="log"
                aria-live="polite"
                aria-relevant="additions"
              >
                <div class="console-lines" id="console-lines"></div>
                <form
                  class="console-input"
                  id="console-form"
                  autocomplete="off"
                >
                  <span class="console-prompt">nohuto@noverse:~/terminal$</span>
                  <span class="console-edit">
                    <span
                      class="console-preview"
                      id="console-preview"
                      aria-hidden="true"
                    ></span>
                    <textarea
                      id="console-command"
                      name="command"
                      rows="1"
                      spellcheck="false"
                      autocomplete="off"
                      autocapitalize="off"
                      aria-label="Console command input"
                    ></textarea>
                    <button type="submit" class="sr-only">
                      Run command
                    </button>
                  </span>
                  <span
                    class="console-timestamp"
                    id="console-timestamp"
                    aria-hidden="true"
                  ></span>
                </form>
              </div>
            </div>
          </div>
        </div>
        <dialog
          class="nv-modal"
          id="bitmask-layer"
          aria-labelledby="bitmask-title"
        >
          <div class="bitmask-window" id="bitmask-window">
            <div class="bitmask-header" id="bitmask-drag">
              <h2 id="bitmask-title">bitmask</h2>
              <button
                class="bitmask-close"
                id="bitmask-close"
                type="button"
                aria-label="Close bitmask calculator"
                title="Close"
              >
                <Icon name="x" />
              </button>
            </div>
            <div class="bitmask-body">
              <div
                class="bitmask-field"
                id="bitmask-field"
                role="group"
                aria-label="32-bit field"
              ></div>
              <div class="bitmask-values" aria-live="polite">
                <label>
                  <span>DEC</span>
                  <input
                    id="bitmask-dec"
                    type="text"
                    value="0"
                    inputmode="numeric"
                    autocomplete="off"
                    spellcheck="false"
                  />
                </label>
                <label>
                  <span>HEX</span>
                  <input
                    id="bitmask-hex"
                    type="text"
                    value="0x00000000"
                    autocomplete="off"
                    spellcheck="false"
                  />
                </label>
                <label>
                  <span>BIN</span>
                  <input
                    id="bitmask-bin"
                    type="text"
                    value="00000000 00000000 00000000 00000000"
                    inputmode="numeric"
                    autocomplete="off"
                    spellcheck="false"
                  />
                </label>
              </div>
              <div class="bitmask-actions">
                <button type="button" data-bitmask-action="invert">
                  Invert
                </button>
                <button type="button" data-bitmask-action="all">
                  Set all
                </button>
                <button type="button" data-bitmask-action="clear">
                  Clear
                </button>
              </div>
            </div>
            <span class="tool-resize-handle" aria-hidden="true"></span>
          </div>
        </dialog>
        <dialog class="nv-modal" id="calc-layer" aria-labelledby="calc-title">
          <div class="calc-window" id="calc-window">
            <div class="calc-header" id="calc-drag">
              <h2 id="calc-title">calculator</h2>
              <button
                class="calc-close"
                id="calc-close"
                type="button"
                aria-label="Close calculator"
                title="Close"
              >
                <Icon name="x" />
              </button>
            </div>
            <div class="calc-body">
              <div class="calc-main">
                <div class="calc-display">
                  <div
                    class="calc-output"
                    id="calc-output"
                    role="group"
                    aria-label="Calculator expression and result"
                  >
                    <input
                      id="calc-input"
                      type="text"
                      value=""
                      inputmode="none"
                      autocomplete="off"
                      spellcheck="false"
                      aria-label="Calculator expression"
                    />
                    <span
                      class="calc-result"
                      id="calc-result"
                      aria-live="polite"
                    ></span>
                  </div>
                  <div
                    class="calc-meta"
                    id="calc-meta"
                    aria-live="polite"
                  ></div>
                </div>
                <div class="calc-keypads">
                  <div
                    class="calc-tools"
                    role="group"
                    aria-label="Calculator functions"
                  >
                    {calcTools.map(([label, value = label]) => (
                      <button
                        type="button"
                        data-calc-value={value}
                        set:html={label}
                      />
                    ))}
                    <button type="button" data-calc-action="negate">
                      +/-
                    </button>
                  </div>
                  <div
                    class="calc-grid"
                    role="group"
                    aria-label="Calculator keypad"
                  >
                    {calcKeys.map((value) => (
                      <button
                        type="button"
                        data-calc-value={value}
                        data-calc-key={
                          /[\d.]/.test(value)
                            ? 'number'
                            : value.length === 1
                              ? 'operator'
                              : undefined
                        }
                      >
                        {value}
                      </button>
                    ))}
                  </div>
                  <div
                    class="calc-actions"
                    role="group"
                    aria-label="Calculator actions"
                  >
                    <button type="button" data-calc-value="!">
                      !
                    </button>
                    <button type="button" data-calc-value="%">
                      %
                    </button>
                    <button
                      type="button"
                      data-calc-action="move-left"
                      aria-label="Move cursor left"
                    >
                      &lt;
                    </button>
                    <button
                      type="button"
                      data-calc-action="move-right"
                      aria-label="Move cursor right"
                    >
                      &gt;
                    </button>
                    <button type="button" data-calc-action="clear">
                      C
                    </button>
                    <button
                      type="button"
                      data-calc-action="delete"
                      aria-label="Delete"
                    >
                      DEL
                    </button>
                    <button
                      type="button"
                      data-calc-action="evaluate"
                      class="calc-enter"
                      aria-label="Enter"
                    >
                      Enter
                    </button>
                  </div>
                </div>
              </div>
            </div>
            <span class="tool-resize-handle" aria-hidden="true"></span>
          </div>
        </dialog>
      </div>
    </section>
  </div>
  <script>
    import '../scripts/terminal/terminal.ts';
  </script>
</StarlightPage>
